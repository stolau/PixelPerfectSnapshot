{
  "name": "pixelperfectsnapshot",
  "version": "0.0.1",
  "description": "Capture DOM snapshots in e2e tests and upload them to a PixelPerfectSnapshot backend",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "lint": "tsc --noEmit",
    "test": "npm run build && vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "ajv": "^8.17.0",
    "esbuild": "^0.24.0",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.48.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
